-- KK's Koala Tycoon: Outfit & Accessory Registration Utility
--
-- ============================================================
-- HOW TO FIT & REGISTER AN OUTFIT
-- ============================================================
-- 1. In Workspace, make sure your Adult Koala model is named 'Koala'.
-- 2. Place your outfit (Accessory or Model or Part) on top of the Koala's head.
--    Use Studio's Move, Rotate, and Scale tools until it looks just right.
-- 3. Select the outfit in the Explorer window.
-- 4. Paste the script below into the Studio Command Bar (View -> Command Bar) and hit Enter.
-- 5. The script will:
--      - Calculate the exact attachment to the head bone.
--      - Automatically convert Accessories to clean Models (preventing Roblox Humanoid auto-scale bugs).
--      - Save the clean template in ReplicatedStorage.KoalaOutfits.
--      - Instantly perform a test equip on your Koala so you can verify the fit!
-- 6. If the fit looks good, delete your temporary editing outfit from Workspace.
--
-- ============================================================
-- RUN SCRIPT BELOW IN STUDIO COMMAND BAR:
-- ============================================================
local Selection = game:GetService("Selection")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local selected = Selection:Get()[1]
if not selected or not (selected:IsA("Model") or selected:IsA("Accessory") or selected:IsA("BasePart") or selected:IsA("Tool")) then
	error("Please select the Outfit (Accessory/Model/Part) in Explorer first!")
end

-- Smart detect: if user clicked 'Handle' inside the hat, target the hat itself
if selected.Name == "Handle" and (selected.Parent:IsA("Accessory") or selected.Parent:IsA("Model")) then
	selected = selected.Parent
end

local koala = workspace:FindFirstChild("Koala") or workspace:FindFirstChildOfClass("Model")
if not koala then error("Ensure an adult koala named 'Koala' is in Workspace.") end

local target = koala:FindFirstChild("head", true) or koala:FindFirstChild("HumanoidRootPart")
local folder = ReplicatedStorage:FindFirstChild("KoalaOutfits") or Instance.new("Folder", ReplicatedStorage)
folder.Name = "KoalaOutfits"

local existing = folder:FindFirstChild(selected.Name)
if existing then existing:Destroy() end

-- Find source handle
local selHandle = nil
if selected:IsA("Accessory") or selected:IsA("Tool") then
	selHandle = selected:FindFirstChild("Handle")
elseif selected:IsA("BasePart") then
	selHandle = selected
else
	selHandle = selected.PrimaryPart or selected:FindFirstChild("Handle") or selected:FindFirstChildOfClass("BasePart")
end

if not selHandle then error("Outfit must have a Handle or PrimaryPart!") end

-- Convert Accessories to clean Models to avoid Roblox Humanoid auto-scaling / floating bugs
local template = nil
local templateHandle = nil
if selected:IsA("Accessory") then
	template = Instance.new("Model")
	template.Name = selected.Name
	for attr, val in pairs(selected:GetAttributes()) do template:SetAttribute(attr, val) end
	for _, child in ipairs(selected:GetChildren()) do
		local c = child:Clone()
		c.Parent = template
		if c.Name == "Handle" then
			templateHandle = c
			template.PrimaryPart = c
		end
	end
else
	template = selected:Clone()
	templateHandle = template.PrimaryPart or template:FindFirstChild("Handle") or (template:IsA("BasePart") and template)
end

template.Parent = folder
template:SetAttribute("AttachPart", "head")

-- Strip Roblox avatar scaling / weld tags
if templateHandle then
	for _, desc in ipairs(templateHandle:GetChildren()) do
		if desc.Name == "OriginalSize" or desc.Name == "AvatarPartScaleType" or desc.Name == "HatAttachment" or desc.Name == "AccessoryWeld" or desc.Name == "Attach" then
			desc:Destroy()
		end
	end
end

local attach = Instance.new("Attachment")
attach.Name = "Attach"
attach.CFrame = selHandle.CFrame:Inverse() * target.WorldCFrame
attach.Parent = templateHandle

print("✅ Saved clean template for: " .. template.Name)

-- Live preview test
local OutfitService = require(ServerScriptService.Services.KoalaOutfitService)
if not koala:GetAttribute("Stage") then koala:SetAttribute("Stage", 4) end
OutfitService.EquipOutfit(koala, template.Name)
print("✨ Live preview equipped!")
